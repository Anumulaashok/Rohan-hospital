---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { INSIGHTS } from '../../data/insights.js';
---
<Base
  title="Fertility Insights: IVF, IUI, PCOS, AMH & More | Rohan Fertility Centre Karimnagar"
  description="Plain-language guides on when to see a fertility specialist, IUI vs IVF vs ICSI, the IVF cycle, PCOS, AMH and semen analysis, fibroids and fertility myths."
>
  <PageHeader te="తెలుసుకోండి" title="Fertility insights" intro="Clear, practical answers to the questions couples ask us most, from when to seek help to what really happens in an IVF cycle." />
  <section class="section">
    <div class="container-x">
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {INSIGHTS.map((a) => (
          <li>
            <a href={`/insights/${a.slug}/`} class="group flex h-full flex-col rounded-[2rem] bg-blush p-7 transition-colors hover:bg-blush-line/60">
              <span class="text-sm font-semibold text-lotus">{a.tag}</span>
              <h2 class="mt-2 text-2xl font-semibold leading-snug">{a.title}</h2>
              <p class="mt-3 flex-1 text-ink/70">{a.summary}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-maroon">Read<Icon name="arrowRight" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-center text-sm text-ink/60">This information is for general education and is not a substitute for medical advice. Please consult a doctor for guidance specific to you.</p>
    </div>
  </section>
  <CtaBand />
</Base>
