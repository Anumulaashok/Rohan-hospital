---
import Base from '../layouts/Base.astro';
---
<Base noindex title="Page not found | Rohan Hospital Karimnagar" description="This page does not exist. Go to the Rohan Hospital home page or book a visit.">
  <section class="section bg-blush">
    <div class="container-x max-w-2xl text-center">
      <h1 class="text-4xl font-bold sm:text-5xl">This page doesn’t exist</h1>
      <p class="lede mx-auto">The link may be old or mistyped. Use the menu, or go straight to one of these.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Go to the home page</a>
        <a href="/book/" class="btn-outline">Book a visit</a>
      </div>
    </div>
  </section>
</Base>
