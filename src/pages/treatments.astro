---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TreatmentGroups from '../components/TreatmentGroups.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { CLINICS } from '../data/clinics.js';
import checkup from '../assets/images/site/stock/pregnancy-checkup.jpg';
---
<Base
  title="IVF, IUI, ICSI, Painless Delivery & Laparoscopy in Karimnagar | Rohan Hospital"
  description="Fertility treatment (IVF, ICSI, IUI), maternity and painless delivery, high-risk pregnancy care, laparoscopy, hysteroscopy and in-house scans at Rohan Hospital, Karimnagar."
  image={checkup}
>
  <PageHeader te="చికిత్సలు" title="Treatments and services" intro="Everything from a first fertility consultation to delivery, surgery and scans, planned by one team so you are not sent from place to place." />

  <section class="section">
    <div class="container-x"><TreatmentGroups /></div>
  </section>

  <section class="section bg-blush">
    <div class="container-x grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div>
        <h2 class="section-title">Speciality clinics</h2>
        <p class="lede">Focused clinics for specific stages of life and specific concerns, for women and men.</p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {CLINICS.map((c) => (
          <li class="flex items-center gap-3 rounded-2xl bg-white px-5 py-4 text-ink ring-1 ring-blush-line">
            <Icon name="check" class="h-5 w-5 shrink-0 text-maroon" />{c}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-x max-w-3xl">
      <h2 class="section-title">Not sure which treatment you need?</h2>
      <p class="lede">That is what the first consultation is for. Dr. Sridevi reviews your history and reports, and explains which tests and treatments make sense for you.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/book/" class="btn-primary"><Icon name="calendar" class="h-5 w-5" />Book a consultation</a>
        <a href="/tariffs/" class="btn-outline">See consultation and procedure charges</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
