---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import BookingForm from '../components/BookingForm.astro';
---
<Base
  title="Book an Appointment with Dr. Sridevi Naresh | Rohan Hospital Karimnagar"
  description="Choose a date and time slot and send your appointment request to Rohan Hospital, Karimnagar on WhatsApp. OP from 9 AM to 8 PM, with a break from 2 to 3 PM."
>
  <PageHeader te="అపాయింట్‌మెంట్ బుక్ చేయండి" title="Book a visit" intro="Fill in a few details and pick a slot. WhatsApp opens with your request ready to send, and the front desk confirms your visit." />
  <section class="section">
    <div class="container-x"><BookingForm /></div>
  </section>
</Base>
