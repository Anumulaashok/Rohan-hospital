---
import Base from '../layouts/Base.astro';
import Location from '../components/Location.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base
  title="Contact & Directions | Rohan Hospital, Choppadandi Road, Karimnagar"
  description="Rohan Hospital & Rohan Fertility (IVF) Centre, 3-6-397, Choppadandi Rd, near Subhash Statue, Karimnagar. Call +91 97041 55550, 0878-2228222. OP hours 10 AM–1 PM and 5–8:30 PM; maternity 24/7."
  faq
>
  <section class="section bg-blush">
    <div class="container-x"><Location headingLevel="h1" /></div>
  </section>
  <section class="section">
    <div class="container-x"><Faq /></div>
  </section>
  <CtaBand />
</Base>
