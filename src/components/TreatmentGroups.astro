---
import Icon from './Icon.astro';
import { useLang } from '../i18n/index.js';
import { getContent } from '../i18n/content.js';

const { lang } = useLang(Astro.url);
const { treatmentGroups } = getContent(lang);
const ICONS = ['flask', 'stethoscope', 'baby', 'scan'];
---
<div class="grid gap-x-12 gap-y-4 lg:grid-cols-2">
  {treatmentGroups.map((group, i) => (
    <article class="flex gap-5 border-t border-blush-line py-7">
      <span class="arch grid h-16 w-14 shrink-0 place-items-center bg-blush text-maroon"><Icon name={ICONS[i]} class="h-7 w-7" /></span>
      <div>
        <h3 class="text-2xl font-semibold">{group.title}</h3>
        <p class="mt-1 text-ink/70">{group.summary}</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {group.items.map((item) => (<li class="rounded-full border border-blush-line bg-white px-3 py-1 text-sm text-ink/80">{item}</li>))}
        </ul>
      </div>
    </article>
  ))}
</div>
