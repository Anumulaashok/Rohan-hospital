---
import { Image, getImage } from 'astro:assets';
import { FAMILY_PHOTOS } from '../data/gallery.js';

const photos = await Promise.all(
  FAMILY_PHOTOS.map(async (p) => ({ ...p, full: (await getImage({ src: p.src, width: 1200, format: 'webp' })).src })),
);
// Second copy lets the auto-scroll wrap around without a visible jump.
const loop = [...photos.map((p) => ({ ...p, clone: false })), ...photos.map((p) => ({ ...p, clone: true }))];
---
<ul class="autoscroll -mx-4 flex items-start gap-5 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0" data-autoscroll>
  {loop.map((p, i) => (
    <li class="w-[62vw] max-w-[260px] shrink-0 snap-start lg:w-[240px]" data-clone={p.clone ? '' : undefined} aria-hidden={p.clone ? 'true' : undefined}>
      <button type="button" class="block w-full overflow-hidden" data-lightbox={p.full} data-lightbox-alt={p.alt} aria-label={`View photo: ${p.alt}`} tabindex={p.clone ? -1 : undefined}>
        <Image src={p.src} alt={p.clone ? '' : p.alt} widths={[260, 400]} sizes="(min-width: 1024px) 240px, 62vw" class:list={['arch aspect-[3/4] w-full object-cover transition-transform duration-500 hover:scale-[1.03]', i % 2 === 1 && 'lg:mt-10']} />
      </button>
    </li>
  ))}
</ul>


<script>
  import { initAutoScroll } from '../ui/autoscroll.js';
  document.querySelectorAll<HTMLElement>('[data-autoscroll]').forEach(initAutoScroll);
</script>
