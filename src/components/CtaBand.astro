---
import Icon from './Icon.astro';
import { useLang } from '../i18n/index.js';

const { lang, tr, link } = useLang(Astro.url);
---
<section class="bg-maroon text-white">
  <div class="container-x flex flex-col gap-8 py-14 xl:flex-row xl:items-center xl:justify-between">
    <div class="max-w-xl">
      {lang === 'te'
        ? <p class="text-lg text-lotus-soft" lang="en">We’re with you at every step</p>
        : <p class="te text-lg text-lotus-soft" lang="te">మీ ప్రయాణంలో మేము తోడుంటాం</p>}
      <h2 class="mt-1 text-3xl font-bold text-white sm:text-4xl">{tr('Talk to Dr. Sridevi about your next step', 'మీ తదుపరి అడుగు గురించి డా. శ్రీదేవి గారితో మాట్లాడండి')}</h2>
      <p class="mt-3 text-white/75">{tr(
        'Pick a slot online and confirm on WhatsApp, or call the front desk. Maternity emergencies are seen 24/7.',
        'ఆన్‌లైన్‌లో సమయాన్ని ఎంచుకుని WhatsApp లో నిర్ధారించుకోండి, లేదా ఫ్రంట్ డెస్క్‌కు కాల్ చేయండి. ప్రసూతి అత్యవసర కేసులు 24/7 చూస్తాం.',
      )}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap xl:shrink-0">
      <a href={link('/book/')} class="btn bg-white text-maroon hover:bg-blush"><Icon name="calendar" class="h-5 w-5" />{tr('Book a visit', 'అపాయింట్‌మెంట్ బుక్ చేయండి')}</a>
      <a href="https://wa.me/919704155550" target="_blank" rel="noopener" class="btn-wa"><Icon name="whatsapp" class="h-5 w-5" />{tr('WhatsApp us', 'WhatsApp చేయండి')}</a>
      <a href="tel:+919704155550" class="btn border border-white/40 text-white hover:bg-white/10"><Icon name="phone" class="h-5 w-5" />{tr('Call 97041 55550', 'కాల్: 97041 55550')}</a>
    </div>
  </div>
</section>
