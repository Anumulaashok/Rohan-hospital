---
import Icon from './Icon.astro';
---
<section class="bg-maroon text-white">
  <div class="container-x flex flex-col gap-8 py-14 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-xl">
      <p class="te text-lg text-lotus-soft" lang="te">మీ ప్రయాణంలో మేము తోడుంటాం</p>
      <h2 class="mt-1 text-3xl font-bold text-white sm:text-4xl">Talk to Dr. Sridevi about your next step</h2>
      <p class="mt-3 text-white/75">Pick a slot online and confirm on WhatsApp, or call the front desk. Maternity emergencies are seen 24/7.</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/book/" class="btn bg-white text-maroon hover:bg-blush"><Icon name="calendar" class="h-5 w-5" />Book a visit</a>
      <a href="https://wa.me/919704155550" target="_blank" rel="noopener" class="btn-wa"><Icon name="whatsapp" class="h-5 w-5" />WhatsApp us</a>
      <a href="tel:+919704155550" class="btn border border-white/40 text-white hover:bg-white/10"><Icon name="phone" class="h-5 w-5" />Call 97041 55550</a>
    </div>
  </div>
</section>
