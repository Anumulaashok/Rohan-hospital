---
import Icon from './Icon.astro';
import { HOSPITAL, HOURS, MAP_DIRECTIONS_URL, GOOGLE_MAPS_URL, EMAIL } from '../config/hospital.js';

interface Props { headingLevel?: 'h1' | 'h2' }
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---
<div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
  <div>
    <Heading class="section-title">Visit us in Karimnagar</Heading>
    <address class="mt-6 not-italic text-ink">
      <p class="font-semibold">{HOSPITAL.name}</p>
      <p class="mt-1 text-ink/75">3-6-397, Choppadandi Rd, Near Subhash Statue,<br />Subhash Nagar, Karimnagar, Telangana 505001</p>
    </address>
    <ul class="mt-6 space-y-2">
      {HOSPITAL.phones.map((p) => (<li class="flex items-center gap-2"><Icon name="phone" class="h-4 w-4 text-maroon" /><a href={`tel:${p.tel}`} class="link">{p.label}</a></li>))}
      <li class="flex items-center gap-2"><Icon name="mail" class="h-4 w-4 text-maroon" /><a href={`mailto:${EMAIL}`} class="link">{EMAIL}</a></li>
    </ul>
    <dl class="mt-6 divide-y divide-blush-line rounded-2xl bg-blush px-5">
      {HOURS.map((h) => (<div class="flex flex-wrap items-baseline justify-between gap-x-4 py-3"><dt class="text-ink/65">{h.label}</dt><dd class="font-semibold text-ink">{h.value}</dd></div>))}
    </dl>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={MAP_DIRECTIONS_URL} target="_blank" rel="noopener" class="btn-primary"><Icon name="navigation" class="h-5 w-5" />Get directions</a>
      <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener" class="btn-outline"><Icon name="mapPin" class="h-5 w-5" />Open in Google Maps</a>
    </div>
  </div>
  <div class="overflow-hidden rounded-[2rem] bg-blush p-2">
    <iframe
      title="Map showing Rohan Hospital, Karimnagar"
      src="https://maps.google.com/maps?q=Rohan%20Hospital%20Subhash%20Nagar%20Karimnagar%20Telangana&t=&z=15&ie=UTF8&iwloc=&output=embed"
      class="h-[420px] w-full rounded-[1.6rem] border-0 md:h-[520px]"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </div>
</div>
