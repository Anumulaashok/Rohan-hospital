---
import Icon from './Icon.astro';
---
<div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
  <form id="booking-form" class="space-y-8 rounded-[2rem] bg-white p-5 shadow-soft ring-1 ring-blush-line sm:p-8" novalidate>
    <fieldset>
      <legend class="font-display text-xl font-semibold text-ink">Patient details</legend>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="booking-name" class="field-label">Full name <span class="text-maroon">*</span></label>
          <input id="booking-name" name="name" data-field="name" type="text" autocomplete="name" class="field" placeholder="e.g. Lakshmi Reddy" required aria-describedby="err-name" />
          <p id="err-name" class="field-error" data-error="name" hidden></p>
        </div>
        <div class="sm:col-span-2">
          <label for="booking-phone" class="field-label">Mobile number <span class="text-maroon">*</span></label>
          <div class="flex">
            <span class="inline-flex items-center rounded-l-xl border border-r-0 border-ink/20 bg-blush px-3 text-sm text-ink/70">+91</span>
            <input id="booking-phone" name="phone" data-field="phone" type="tel" inputmode="numeric" autocomplete="tel-national" class="field rounded-l-none" placeholder="10-digit mobile number" required aria-describedby="err-phone" />
          </div>
          <p id="err-phone" class="field-error" data-error="phone" hidden></p>
        </div>
        <div>
          <label for="booking-age" class="field-label">Age <span class="font-normal text-ink/50">(optional)</span></label>
          <input id="booking-age" name="age" type="number" inputmode="numeric" min="1" max="120" class="field" placeholder="e.g. 29" />
        </div>
        <div>
          <label for="booking-gender" class="field-label">Gender <span class="font-normal text-ink/50">(optional)</span></label>
          <select id="booking-gender" name="gender" class="field">
            <option value="">Prefer not to say</option>
            <option>Female</option>
            <option>Male</option>
            <option>Other</option>
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset id="doctor-field" data-field="doctor" tabindex="-1" hidden>
      <legend class="font-display text-xl font-semibold text-ink">Doctor</legend>
      <div class="mt-4 max-w-md">
        <label for="booking-doctor" class="field-label">Choose a doctor <span class="text-maroon">*</span></label>
        <select id="booking-doctor" name="doctor" class="field" aria-describedby="err-doctor"></select>
        <p id="err-doctor" class="field-error" data-error="doctor" hidden></p>
      </div>
    </fieldset>

    <fieldset data-field="service" tabindex="-1">
      <legend class="font-display text-xl font-semibold text-ink">Department or service</legend>
      <div id="service-chips" class="mt-4 grid gap-2 sm:grid-cols-2"></div>
    </fieldset>

    <fieldset>
      <legend class="font-display text-xl font-semibold text-ink">Preferred date and time</legend>
      <div class="mt-4 max-w-xs">
        <label for="booking-date" class="field-label">Date <span class="text-maroon">*</span></label>
        <input id="booking-date" name="date" data-field="date" type="date" class="field" required aria-describedby="err-date" />
        <p id="err-date" class="field-error" data-error="date" hidden></p>
      </div>
      <div class="mt-6" data-field="slot" tabindex="-1">
        <p class="field-label">Time slot <span class="text-maroon">*</span></p>
        <div id="slot-grid" class="space-y-4" role="group" aria-label="Available time slots"></div>
        <p class="field-error" data-error="slot" hidden></p>
      </div>
    </fieldset>

    <fieldset>
      <legend class="font-display text-xl font-semibold text-ink">Symptoms or notes <span class="text-sm font-normal text-ink/50">(optional)</span></legend>
      <label for="booking-notes" class="sr-only">Symptoms or notes</label>
      <textarea id="booking-notes" name="notes" rows="3" maxlength="500" class="field mt-4" placeholder="Briefly describe your concern, e.g. irregular periods, trying to conceive for 2 years"></textarea>
    </fieldset>

    <div id="pay-online-block" class="space-y-4" hidden>
      <div class="rounded-2xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900" data-field="acceptTerms" tabindex="-1">
        <p class="font-semibold">Before you pay</p>
        <p id="online-terms-text" class="mt-1"></p>
        <p id="online-hold-text" class="mt-1 text-amber-800/80"></p>
        <label class="mt-3 flex items-start gap-2 font-medium">
          <input id="accept-terms" type="checkbox" name="acceptTerms" class="mt-0.5 h-4 w-4 accent-maroon" />
          I understand the payment is non-refundable and agree to the terms above.
        </label>
        <p class="field-error" data-error="acceptTerms" hidden></p>
      </div>
      <button id="pay-online" type="button" class="btn-primary w-full whitespace-normal py-4 text-center text-base">
        <span id="pay-online-label">Pay online to confirm</span>
      </button>
      <p id="pay-online-error" role="alert" class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700" hidden></p>
      <p class="-mt-2 text-center text-sm text-ink/60">UPI, cards or netbanking. Your slot is confirmed as soon as the payment goes through.</p>
    </div>

    <button id="booking-submit" type="submit" class="btn-wa w-full whitespace-normal py-4 text-center text-base">
      <Icon name="whatsapp" class="h-6 w-6" />
      <span id="booking-submit-label">Send booking on WhatsApp</span>
    </button>
    <p id="booking-submit-hint" class="-mt-4 text-center text-sm text-ink/60">WhatsApp opens with your details filled in. Nothing is sent until you press send.</p>
  </form>

  <aside class="lg:sticky lg:top-28 lg:self-start" aria-labelledby="preview-title">
    <div class="overflow-hidden rounded-[2rem] shadow-soft ring-1 ring-blush-line">
      <div class="flex items-center gap-3 bg-[#075E54] px-5 py-3 text-white">
        <span class="grid h-9 w-9 place-items-center rounded-full bg-white/15 text-sm font-bold">RH</span>
        <div>
          <p id="preview-title" class="text-sm font-semibold">Message preview</p>
          <p class="text-xs text-white/75">To Rohan Hospital, +91 97041 55550</p>
        </div>
      </div>
      <div class="bg-[#ECE5DD] p-4 sm:p-5">
        <div class="relative ml-auto max-w-[95%] rounded-xl rounded-tr-none bg-[#DCF8C6] p-3.5 shadow-sm">
          <div id="wa-preview" class="whitespace-pre-wrap break-words text-[13px] leading-relaxed text-ink"></div>
        </div>
      </div>
    </div>
    <p class="mt-4 text-center text-sm text-ink/60">
      Prefer to talk? Call <a href="tel:+919704155550" class="link">97041 55550</a> or <a href="tel:+919676603113" class="link">96766 03113</a>
    </p>
  </aside>
</div>

<script>
  import { initBookingForm } from '../booking/form.js';
  initBookingForm(document.getElementById('booking-form'));
</script>
