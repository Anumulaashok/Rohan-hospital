---
import Icon from './Icon.astro';
import { useLang } from '../i18n/index.js';

const { tr, link } = useLang(Astro.url);
---
<div class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-3 gap-2 border-t border-blush-line bg-white/95 p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] shadow-[0_-4px_16px_rgba(42,26,34,0.08)] backdrop-blur md:hidden">
  <a href="tel:+919704155550" class="btn-outline w-full px-2"><Icon name="phone" class="h-4 w-4" />{tr('Call', 'కాల్')}</a>
  <a href="https://wa.me/919704155550" target="_blank" rel="noopener" class="btn-wa w-full px-2"><Icon name="whatsapp" class="h-4 w-4" />WhatsApp</a>
  <a href={link('/book/')} class="btn-primary w-full px-2"><Icon name="calendar" class="h-4 w-4" />{tr('Book', 'బుక్')}</a>
</div>
