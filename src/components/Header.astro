---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { NAV } from '../lib/nav.js';
import logo from '../assets/images/site/logo.png';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---
<header id="site-header" class="sticky top-0 z-40 border-b border-blush-line/70 bg-white/95 backdrop-blur transition-shadow">
  <div class="container-x flex h-[72px] items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3" aria-label="Rohan Hospital home">
      <Image src={logo} alt="" width={44} height={44} class="h-10 w-10 shrink-0 rounded-full sm:h-11 sm:w-11" loading="eager" />
      <span class="leading-tight">
        <span class="block whitespace-nowrap font-display text-base font-bold text-maroon sm:text-lg" style="font-stretch:115%">Rohan Hospital</span>
        <span class="hidden whitespace-nowrap text-xs text-ink/60 sm:block">Fertility (IVF) Centre, Karimnagar</span>
      </span>
    </a>
    <nav class="hidden items-center gap-1 text-[15px] font-medium xl:flex" aria-label="Primary">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={['rounded-full px-3 py-2 transition-colors hover:text-maroon', isActive(item.href) ? 'bg-blush text-maroon' : 'text-ink/75']}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href="tel:+919704155550" class="btn-outline hidden px-4 sm:inline-flex"><Icon name="phone" class="h-4 w-4" />97041 55550</a>
      <a href="/book/" class="btn-primary px-5">Book visit</a>
      <button id="nav-toggle" type="button" class="grid h-11 w-11 place-items-center rounded-full text-ink xl:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="border-t border-blush-line bg-white xl:hidden" aria-label="Mobile" hidden>
    <div class="container-x grid grid-cols-2 gap-x-4 py-3 text-base font-medium">
      <a href="/" class="py-3" aria-current={path === '/' ? 'page' : undefined}>Home</a>
      {NAV.map((item) => (
        <a href={item.href} class:list={['py-3', isActive(item.href) && 'text-maroon']} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href="/book/" class="py-3 text-maroon">Book appointment</a>
    </div>
  </nav>
</header>
