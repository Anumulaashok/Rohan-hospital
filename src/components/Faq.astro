---
import Icon from './Icon.astro';
import { FAQS } from '../data/faqs.js';
---
<div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
  <div>
    <h2 class="section-title">Common questions</h2>
    <p class="lede">Can’t find your answer? Call <a href="tel:+919704155550" class="link">97041 55550</a>.</p>
  </div>
  <div class="divide-y divide-blush-line border-y border-blush-line">
    {FAQS.map((f, i) => (
      <details class="group" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5">
          <h3 class="font-sans text-[17px] font-semibold text-ink">{f.q}</h3>
          <Icon name="chevronDown" class="mt-0.5 h-5 w-5 shrink-0 text-maroon transition-transform group-open:rotate-180" />
        </summary>
        <p class:list={['pr-8 text-ink/75', f.video ? 'pb-4' : 'pb-6']}>{f.a}</p>
        {f.video && (
          <button type="button" class="mb-6 inline-flex items-center gap-2 rounded-full bg-blush px-4 py-2 text-sm font-semibold text-maroon transition-colors hover:bg-blush-line" data-video={f.video.id} data-video-short={f.video.short ? '' : undefined} data-video-title={f.video.title}>
            <Icon name="youtube" class="h-4 w-4" />Watch: {f.video.title}
          </button>
        )}
      </details>
    ))}
  </div>
</div>
