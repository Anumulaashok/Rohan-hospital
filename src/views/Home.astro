---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DoctorIntro from '../components/DoctorIntro.astro';
import TreatmentGroups from '../components/TreatmentGroups.astro';
import FamiliesStrip from '../components/FamiliesStrip.astro';
import Facilities from '../components/Facilities.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Location from '../components/Location.astro';
import { GOOGLE_REVIEWS } from '../config/hospital.js';
import { useLang } from '../i18n/index.js';
import { getContent } from '../i18n/content.js';
import withTwins from '../assets/images/site/dr-sridevi-with-twins.jpg';
import triplets from '../assets/images/site/dr-sridevi-newborn-triplets.jpg';
import withBaby from '../assets/images/site/dr-sridevi-with-baby.jpg';
import facade from '../assets/images/site/hospital-facade.jpg';

const { lang, tr, link } = useLang(Astro.url);
const { insights, familyPhotos } = getContent(lang);
const facts = [
  { icon: 'star', text: tr(`Rated ${GOOGLE_REVIEWS.rating} on Google across ${GOOGLE_REVIEWS.count} reviews`, `${GOOGLE_REVIEWS.count} గూగుల్ సమీక్షల్లో ${GOOGLE_REVIEWS.rating} రేటింగ్`) },
  { icon: 'heart', text: tr('Caring for Karimnagar families for over a decade', 'పదేళ్లకు పైగా కరీంనగర్ కుటుంబాలకు సేవ') },
  { icon: 'clock', text: tr('Maternity and emergency care, 24 hours a day', 'ప్రసూతి & అత్యవసర సేవలు, 24 గంటలూ') },
  { icon: 'flask', text: tr('IVF lab, 3D scans and 24-hour lab in-house', 'IVF ల్యాబ్, 3D స్కాన్‌లు, 24 గంటల ల్యాబ్ ఆసుపత్రిలోనే') },
];
---
<Base
  title={tr(
    'Dr. Sridevi Naresh, IVF & Fertility Specialist in Karimnagar | Rohan Hospital & Rohan Fertility (IVF) Centre',
    'డా. శ్రీదేవి నరేష్, కరీంనగర్‌లో IVF & ఫెర్టిలిటీ స్పెషలిస్ట్ | రోహన్ హాస్పిటల్ & రోహన్ ఫెర్టిలిటీ (IVF) సెంటర్',
  )}
  description={tr(
    'Rohan Hospital & Rohan Fertility (IVF) Centre, Karimnagar. IVF, ICSI, IUI, painless delivery, high-risk pregnancy care and laparoscopy, led by Dr. Anamalla Sridevi Naresh (MBBS, DGO, MRM London; Cleveland Clinic IVF training). Book on WhatsApp.',
    'రోహన్ హాస్పిటల్ & రోహన్ ఫెర్టిలిటీ (IVF) సెంటర్, కరీంనగర్. డా. ఎనమల్ల శ్రీదేవి నరేష్ (MBBS, DGO, MRM లండన్; క్లీవ్‌ల్యాండ్ క్లినిక్ IVF శిక్షణ) ఆధ్వర్యంలో IVF, ICSI, IUI, నొప్పిలేని ప్రసవం, హై-రిస్క్ గర్భధారణ సంరక్షణ, లాపరోస్కోపీ. WhatsApp లో బుక్ చేయండి.',
  )}
  faq
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-blush">
    <div class="container-x grid items-center gap-12 pb-16 pt-12 lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)] lg:pb-24 lg:pt-20">
      <div>
        {lang === 'te' ? (
          <>
            <p class="text-lg font-semibold text-lotus sm:text-xl">రోహన్ ఫెర్టిలిటీ (IVF) సెంటర్, కరీంనగర్</p>
            <h1 class="mt-4 text-[2.3rem] font-bold sm:text-[3rem] lg:text-[3.1rem]">మాతృత్వం ఒక వరం…<br />మీకూ ఉంది ఆ అవకాశం</h1>
          </>
        ) : (
          <>
            <p class="te text-2xl font-semibold leading-snug text-lotus sm:text-3xl" lang="te">మాతృత్వం ఒక వరం…<br />మీకూ ఉంది ఆ అవకాశం</p>
            <h1 class="mt-4 text-[2.5rem] font-bold leading-[1.04] tracking-tight sm:text-6xl lg:text-[3.6rem]" style="font-stretch:118%">
              Motherhood is a blessing. It can be yours too.
            </h1>
          </>
        )}
        <p class="mt-6 max-w-xl text-lg text-ink/75">{tr(
          'Fertility treatment, safe and painless delivery, and keyhole surgery in Karimnagar, led by Dr. Anamalla Sridevi Naresh, trained at Homerton University, London and Cleveland Clinic, USA.',
          'కరీంనగర్‌లో ఫెర్టిలిటీ చికిత్స, సురక్షితమైన నొప్పిలేని ప్రసవం, కీహోల్ సర్జరీ. లండన్‌లోని హోమర్టన్ యూనివర్సిటీ, USA లోని క్లీవ్‌ల్యాండ్ క్లినిక్‌లో శిక్షణ పొందిన డా. ఎనమల్ల శ్రీదేవి నరేష్ గారి ఆధ్వర్యంలో.',
        )}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={link('/book/')} class="btn-primary text-base"><Icon name="calendar" class="h-5 w-5" />{tr('Book a visit', 'అపాయింట్‌మెంట్ బుక్ చేయండి')}</a>
          <a href="https://wa.me/919704155550" target="_blank" rel="noopener" class="btn-wa text-base"><Icon name="whatsapp" class="h-5 w-5" />{tr('WhatsApp us', 'WhatsApp చేయండి')}</a>
        </div>
        <p class="mt-5 flex flex-wrap items-center gap-2 text-[15px] text-ink/70">
          <Icon name="phone" class="h-4 w-4 text-maroon" />{tr('Emergency, any time:', 'అత్యవసరం, ఎప్పుడైనా:')} <a href="tel:+919704155550" class="link">97041 55550</a>
        </p>
      </div>

      <div class="relative mx-auto grid w-full max-w-lg grid-cols-[1fr_1.25fr_1fr] items-end gap-3 sm:gap-4">
        <Image src={triplets} alt={familyPhotos[1].alt} widths={[200, 320]} sizes="(min-width: 1024px) 160px, 28vw" loading="eager" class="arch arch-rise aspect-[3/5] w-full object-cover shadow-soft" style="animation-delay:.15s" />
        <Image src={withTwins} alt={familyPhotos[0].alt} widths={[260, 420]} sizes="(min-width: 1024px) 210px, 36vw" loading="eager" fetchpriority="high" class="arch arch-rise mb-10 aspect-[3/5] w-full object-cover shadow-soft" />
        <Image src={withBaby} alt={familyPhotos[2].alt} widths={[200, 320]} sizes="(min-width: 1024px) 160px, 28vw" loading="eager" class="arch arch-rise aspect-[3/5] w-full object-cover shadow-soft" style="animation-delay:.3s" />
      </div>
    </div>
  </section>

  <!-- Facts -->
  <section class="border-b border-blush-line">
    <ul class="container-x grid grid-cols-1 divide-y divide-blush-line sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x">
      {facts.map((f) => (
        <li class="flex items-center gap-3 py-5 sm:px-4 lg:first:pl-0">
          <Icon name={f.icon} class="h-6 w-6 shrink-0 text-lotus" />
          <span class="text-[15px] font-medium text-ink">{f.text}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Doctor -->
  <section class="section">
    <div class="container-x">
      <DoctorIntro>
        <a href={link('/doctors/')} class="btn-outline mt-8">{tr('Meet Dr. Sridevi and the team', 'డా. శ్రీదేవి గారిని, మా టీమ్‌ను కలవండి')}<Icon name="arrowRight" class="h-4 w-4" /></a>
      </DoctorIntro>
    </div>
  </section>

  <!-- Treatments -->
  <section class="section bg-blush">
    <div class="container-x">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="section-title">{tr('Care for every stage, under one roof', 'ప్రతి దశకూ సంరక్షణ, ఒకే చోట')}</h2>
          <p class="lede">{tr('From your first fertility check to delivery and beyond, with scans and lab tests in the same building.', 'మొదటి ఫెర్టిలిటీ పరీక్ష నుంచి ప్రసవం వరకు, ఆ తర్వాత కూడా; స్కాన్‌లు, ల్యాబ్ పరీక్షలు అదే భవనంలో.')}</p>
        </div>
        <a href={link('/treatments/')} class="btn-outline shrink-0">{tr('All treatments', 'అన్ని చికిత్సలు')}</a>
      </div>
      <div class="mt-10"><TreatmentGroups /></div>
    </div>
  </section>

  <!-- Families -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="section-title">{tr('Moments from Rohan Hospital', 'రోహన్ హాస్పిటల్ నుంచి కొన్ని క్షణాలు')}</h2>
          <p class="lede">{tr('Dr. Sridevi with some of the families she has cared for.', 'తాను సంరక్షించిన కొన్ని కుటుంబాలతో డా. శ్రీదేవి.')}</p>
        </div>
        <a href={link('/gallery/')} class="btn-outline shrink-0">{tr('Open the gallery', 'గ్యాలరీ చూడండి')}</a>
      </div>
      <div class="mt-10"><FamiliesStrip /></div>
    </div>
  </section>

  <!-- Facilities -->
  <section class="section bg-blush">
    <div class="container-x grid items-start gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
      <div class="bg-blush lg:sticky lg:top-28">
        <h2 class="section-title">{tr('Equipped for the unexpected', 'ఏ పరిస్థితికైనా సిద్ధంగా')}</h2>
        <p class="lede">{tr(
          'An IVF lab, ICUs, a 3D scanner and a round-the-clock lab mean fewer trips elsewhere and faster decisions when it matters.',
          'IVF ల్యాబ్, ICUలు, 3D స్కానర్, రోజంతా పనిచేసే ల్యాబ్ ఉండటం వల్ల వేరే చోటికి వెళ్లాల్సిన అవసరం తగ్గుతుంది, అవసరమైనప్పుడు నిర్ణయాలు త్వరగా తీసుకోవచ్చు.',
        )}</p>
        <Image src={facade} alt={tr('Rohan Hospital building on Choppadandi Road, Karimnagar', 'కరీంనగర్, చొప్పదండి రోడ్‌లోని రోహన్ హాస్పిటల్ భవనం')} widths={[320, 560]} sizes="300px" class="mt-8 hidden w-full max-w-[300px] mix-blend-multiply lg:block" />
        <a href={link('/facilities/')} class="btn-outline mt-8">{tr('See all facilities', 'అన్ని సౌకర్యాలు చూడండి')}</a>
      </div>
      <Facilities limit={8} cols={2} />
    </div>
  </section>

  <!-- Insights -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="section-title">{tr('Before your first visit', 'మొదటి సందర్శనకు ముందు')}</h2>
          <p class="lede">{tr('Plain answers to what couples ask us most.', 'దంపతులు మమ్మల్ని ఎక్కువగా అడిగే ప్రశ్నలకు సులభమైన సమాధానాలు.')}</p>
        </div>
        <a href={link('/insights/')} class="btn-outline shrink-0">{tr('All insights', 'అన్ని వ్యాసాలు')}</a>
      </div>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {insights.slice(0, 3).map((a) => (
          <li>
            <a href={link(`/insights/${a.slug}/`)} class="group flex h-full flex-col rounded-[2rem] bg-blush p-7 transition-colors hover:bg-blush-line/60">
              <span class="text-sm font-semibold text-lotus">{a.tag}</span>
              <h3 class="mt-2 text-2xl font-semibold leading-snug">{a.title}</h3>
              <p class="mt-3 flex-1 text-ink/70">{a.summary}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-maroon">{tr('Read', 'చదవండి')}<Icon name="arrowRight" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section bg-blush">
    <div class="container-x"><Reviews limit={6} /></div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-x"><Faq /></div>
  </section>

  <CtaBand />

  <!-- Location -->
  <section class="section">
    <div class="container-x"><Location /></div>
  </section>
</Base>
